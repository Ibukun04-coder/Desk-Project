// Phase 1 data layer.
// All price fields are strings: providers return decimal strings and we store them
// verbatim, so no float rounding is introduced (works the same on SQLite and Postgres).
// All DateTime columns are UTC.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Candle {
  id         String   @id @default(cuid())
  symbol     String
  timeframe  String
  openTime   DateTime
  open       String
  high       String
  low        String
  close      String
  volume     String?
  provider   String
  ingestedAt DateTime @default(now())

  @@unique([symbol, timeframe, openTime])
  @@index([symbol, timeframe])
}

model CalendarEvent {
  id           String   @id @default(cuid())
  externalId   String   @unique
  title        String
  country      String
  currency     String
  impact       String // low | medium | high
  scheduledAt  DateTime
  actual       String?
  forecast     String?
  previous     String?
  source       String
  affectedPairs Json // Pair[] — e.g. ["EURUSD","GBPUSD"]
  ingestedAt   DateTime @default(now())

  @@index([scheduledAt])
}

model NewsItem {
  id          String   @id @default(cuid())
  url         String   @unique
  source      String
  title       String
  summary     String
  rawText     String
  publishedAt DateTime
  currencies  Json // string[] e.g. ["USD"]
  pairTags    Json // Pair[] e.g. ["EURUSD","XAUUSD"]
  impactScore Int // 0-100
  ingestedAt  DateTime @default(now())

  @@index([publishedAt])
}

model IngestRun {
  id         String    @id @default(cuid())
  kind       String // price | calendar | news
  status     String // running | success | partial | failed | skipped
  startedAt  DateTime
  finishedAt DateTime?
  error      String?
  stats      Json? // { fetched, inserted, updated, skipped, failedCalls, errors, provider, mock }

  @@index([kind, startedAt])
}

// Phase 4a playbook: written SMC rules that BLOCK or DOWNGRADE setups.
// Rules beat the model — a setup failing an enabled rule cannot stay grade A.
// whenJson is machine-readable ({ kind, ... }); the evaluator switches on kind.
model PlaybookRule {
  id        String   @id @default(cuid())
  title     String
  body      String   @default("")
  enabled   Boolean  @default(true)
  severity  String   // block | downgrade
  appliesTo String   @default("all") // all | long | short
  whenJson  String   @default("{}") // JSON-encoded structured condition
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, sortOrder])
}


// Phase 2 fundamental bias snapshots. Kept per pair; capped at MAX_SNAPSHOTS_PER_PAIR.
model BiasSnapshot {
  id        String   @id @default(cuid())
  pair      String // EURUSD | GBPUSD | USDJPY | XAUUSD
  bias      String // bullish | bearish | mixed | neutral
  confidence Int    // 0-100
  drivers   Json     // [{ type: "news" | "calendar", text: string }]
  nextEvent Json?    // { title, scheduledAt, currency, impact, forecast, previous, actual } | null
  invalidation String
  method    String   // rules-v1
  usedLlm   Boolean
  asOf      DateTime
  createdAt DateTime @default(now())

  @@unique([pair, asOf])
  @@index([pair, createdAt])
}

// Phase 6 daily bias: higher-timeframe directional filter based on the
// previous completed daily candle and liquidity left behind.
// Computed once per day per pair; acts as an additional filter on top of
// Phase 2 news/calendar bias — never replaces it.
model DailyBias {
  id            String   @id @default(cuid())
  pair          String   // EURUSD | GBPUSD | USDJPY | XAUUSD
  bias          String   // bullish | bearish | neutral
  confidence    Int      // 0-100
  strength      Int      // 0-100 (previous day body strength)
  previousDayOpen  String
  previousDayHigh   String
  previousDayLow    String
  previousDayClose  String
  bodyDirection     String // bullish | bearish | neutral
  bodyStrength      String // 0-1 decimal string
  closePosition     String // 0-1 decimal string (where close sits in range)
  liquidityTaken    String // none | buySide | sellSide | both
  liquidityLeft     String // none | buySide | sellSide | both
  pdh               String // previous day high
  pdl               String // previous day low
  eqh               String? // equal highs level (nullable)
  eql               String? // equal lows level (nullable)
  invalidation      String
  method          String   // rules-v1
  asOf       DateTime // the date of the previous completed daily candle (UTC midnight)
  createdAt  DateTime @default(now())
  liquiditySweeps  Json?   // { index, time, epoch, price, direction, sweptLevel, closeInside }[]
  liquidityRuns    Json?   // { index, time, epoch, price, direction, brokenLevel, continuation }[]
  liquidityDigest  String? // cached JSON.stringify([...sweeper, ...runs]) for cheap change detection

  @@unique([pair, asOf])
  @@index([pair, createdAt])
}

// Phase 5 paper journal: a setup logged with the analysis that justified it,
// then closed later with an outcome. ANALYSIS ONLY — nothing here places or
// simulates a fill. History is a snapshot: bias/playbook/SMC are copied at
// log time and never refreshed, so later playbook or bias changes cannot
// rewrite old entries. Prices/plannedR/realizedR are strings, same convention
// as Candle: decimal strings stored verbatim, no float rounding.
model JournalEntry {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pair      String // EURUSD | GBPUSD | USDJPY | XAUUSD
  timeframe String // M15 | H1 | H4 | D1
  direction String // long | short
  status    String // idea | active | closed | invalidated | expired

  entryPrice   String
  stopPrice    String
  targetPrice  String
  target2Price String? // optional second target
  plannedR     String // |target-entry| / |entry-stop|, fixed at log time

  thesis String // max 1000 chars, validated in Zod at the route edge

  // Snapshots taken at log time, never refreshed.
  biasSnapshot     Json? // { direction, confidence, drivers[], invalidation, asOf }
  biasNote         String? // required when biasSnapshot is null (bias not loadable)
  playbookSnapshot Json? // { verdict, grade, originalGrade, fired[], alignment, asOf }
  smcSnapshot      Json? // trimmed SmcSnapshot (existing SMC types); null when none

  exitPrice   String?
  exitReason  String? // target | stop | manual | invalidated | expired
  result      String? // win | loss | breakeven | scratched
  realizedR   String? // rounded to 2dp at close; null when skipped
  closedAt    DateTime?
  reviewNote  String?

  source         String // from_setup | manual
  overrideReason String? // required when the playbook verdict is block
  tags           Json // string[]

  @@index([pair, status])
  @@index([status, createdAt])
  @@index([closedAt])
}
