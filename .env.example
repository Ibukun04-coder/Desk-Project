# SQLite by default (no Postgres configured). For Postgres use a postgres:// URL.
DATABASE_URL="file:./dev.db"

# twelvedata | polygon | oanda | mock
# If left empty, the first provider with an API key below is used; otherwise mock mode.
# IMPORTANT: PRICE_PROVIDER=twelvedata with an empty TWELVEDATA_API_KEY stays mock.
PRICE_PROVIDER=mock
TWELVEDATA_API_KEY=
POLYGON_API_KEY=
OANDA_API_KEY=
OANDA_ACCOUNT_ID=

# finnhub | mock (default finnhub when FINNHUB_API_KEY is set)
# NewsAPI fallback for general business headlines.
NEWS_PROVIDER=finnhub
NEWS_API_KEY=
FINNHUB_API_KEY=

# Used by `npm run ingest -- --watch`
INGEST_INTERVAL_SECONDS=60

# ------------------------------------------
# Phase 2: optional LLM overlay (bias desk)
# ------------------------------------------
# Leave this section EMPTY to run Phase 2 in pure rules mode with no LLM keys.
# Only one key is required; the bias engine will use the first present one.
#
# OPENAI_API_KEY=sk-...
# XAI_API_KEY=xai-...
# GROK_API_KEY=google-...
#
# If none is set: usedLlm=false on every BiasResult, and
# POST /api/bias/recompute + POST /api/ingest/all never call an LLM.
